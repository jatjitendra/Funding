# Copy to .env for the scripts in this folder. Do not commit .env.
#
# The apply/reset scripts read DATABASE_URL, and accept either the plain libpq
# form or SQLAlchemy's postgresql+psycopg:// form (the driver suffix is stripped
# automatically).

DATABASE_URL=postgresql://apexfund:apexfund_local_only@127.0.0.1:5432/apexfund

# Alternatively leave DATABASE_URL empty and use the standard libpq variables:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=apexfund
# PGPASSWORD=
# PGDATABASE=apexfund

# --- docker-compose.yml -------------------------------------------------------
POSTGRES_DB=apexfund
POSTGRES_USER=apexfund
POSTGRES_PASSWORD=apexfund_local_only
POSTGRES_PORT=5432
