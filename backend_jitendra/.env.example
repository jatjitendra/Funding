# Copy to .env and adjust. Every value below is optional.

APP_NAME=ApexFund API
ENVIRONMENT=development
DEBUG=true

# Defaults to a local SQLite file inside backend_jitendra/.
# For Postgres (psycopg 3 driver):
# DATABASE_URL=postgresql+psycopg://apexfund:apexfund@localhost:5432/apexfund
DATABASE_URL=

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=10080

# Serve the static frontend from this process (single origin, no CORS needed).
SERVE_FRONTEND=true
FRONTEND_DIR=

# Only needed when the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8000

BINANCE_BASE_URL=https://fapi.binance.com
MARKET_CACHE_SECONDS=1.0
MARKET_TIMEOUT_SECONDS=4.0
